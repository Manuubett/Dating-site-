<!DOCTYPE html>  
<html lang="en">  
<head>  
  <meta charset="utf-8" />  
  <meta name="viewport" content="width=device-width,initial-scale=1" />  
  <title>DateLink — My Profile</title>  
  <style>  
    body {  
      font-family: 'Poppins', sans-serif;  
      background: linear-gradient(135deg, #ffe6ee, #fff0f5);  
      margin: 0;  
      padding: 0;  
      display: flex;  
      justify-content: center;  
      align-items: flex-start;  
      min-height: 100vh;  
    }  
    
    nav {  
      background: #fff;  
      position: fixed;  
      top: 0; left: 0; width: 100%;  
      display: flex; justify-content: space-around; align-items: center;  
      height: 55px;  
      box-shadow: 0 2px 8px rgba(0,0,0,.1);  
      z-index: 10;  
    }  
    
    nav a {  
      text-decoration: none;  
      color: #ff4f87;  
      font-weight: 600;  
    }  

    .container {  
      background: white;  
      width: 95%;  
      max-width: 500px;  
      border-radius: 20px;  
      padding: 25px;  
      box-shadow: 0 6px 30px rgba(0,0,0,.08);  
      margin-top: 90px;  
      text-align: center;  
      transition: all 0.3s ease;  
    }  

    h2 {  
      color: #ff4f87;  
      margin-bottom: 10px;  
    }  

    input, textarea, select, button {  
      width: 100%;  
      padding: 10px;  
      margin: 8px 0;  
      border-radius: 10px;  
      border: 1px solid #e6e6e6;  
      box-sizing: border-box;  
      font-family: inherit;  
      font-size: 15px;  
    }  

    button {  
      background: #ff4f87;  
      color: #fff;  
      border: none;  
      font-weight: 600;  
      cursor: pointer;  
      transition: 0.2s;  
    }  

    button:hover {  
      background: #ff2f75;  
    }  

    .photo {  
      width: 120px;  
      height: 120px;  
      border-radius: 50%;  
      object-fit: cover;  
      margin: 10px auto;  
      display: block;  
      border: 4px solid #ffb6c1;  
    }  

    .profile-info {  
      text-align: left;  
      margin-top: 15px;  
    }  

    .profile-info p {  
      margin: 6px 0;  
      color: #444;  
    }  

    .follow-stats {  
      display: flex;  
      justify-content: space-around;  
      margin-top: 10px;  
      color: #ff4f87;  
      font-weight: 600;  
      cursor: pointer;  
    }  

    .followers-list {  
      display: none;  
      background: #fff0f5;  
      border-radius: 12px;  
      margin-top: 10px;  
      padding: 10px;  
      text-align: left;  
      max-height: 250px;  
      overflow-y: auto;  
    }  

    .follower-item {  
      display: flex;  
      align-items: center;  
      justify-content: space-between;  
      margin-bottom: 8px;  
      background: #fff;  
      padding: 6px 8px;  
      border-radius: 8px;  
    }  

    .follower-item img {  
      width: 40px;  
      height: 40px;  
      border-radius: 50%;  
      object-fit: cover;  
      margin-right: 8px;  
      cursor: pointer;  
    }  

    .follow-back {  
      background: #ff4f87;  
      border: none;  
      border-radius: 6px;  
      color: white;  
      padding: 4px 8px;  
      font-size: 13px;  
      cursor: pointer;  
    }  

    .chips-container {  
      display: flex;  
      flex-wrap: wrap;  
      gap: 6px;  
      margin: 8px 0;  
    }  

    .chip {  
      background: #ffe6ee;  
      color: #ff4f87;  
      border: 1px solid #ffb6c1;  
      border-radius: 20px;  
      padding: 6px 12px;  
      cursor: pointer;  
      transition: all 0.2s ease;  
      font-size: 14px;  
      user-select: none;  
    }  

    .chip.selected {  
      background: #ff4f87;  
      color: white;  
      border-color: #ff4f87;  
    }  

    #toggleEdit, #logoutBtn {  
      margin-top: 12px;  
      width: 100%;  
      border-radius: 10px;  
    }  

    #logoutBtn {  
      background: #555;  
    }  

    /* --- Posts Section --- */  
    .posts-section {  
      margin-top: 25px;  
    }  

    .posts-grid {  
      display: grid;  
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));  
      gap: 10px;  
      margin-top: 10px;  
    }  

    .post-card {  
      position: relative;  
      border-radius: 10px;  
      overflow: hidden;  
      cursor: pointer;  
      box-shadow: 0 2px 6px rgba(0,0,0,.1);  
      transition: transform 0.2s;  
      background: #f8f9fb;  
      min-height: 120px;  
    }  

    .post-card:hover {  
      transform: scale(1.03);  
    }  

    .post-card img,  
    .post-card video {  
      width: 100%;  
      height: 120px;  
      object-fit: cover;  
      border-radius: 10px;  
    }  

    .text-post {  
      padding: 15px;  
      border-radius: 10px;  
      text-align: center;  
      display: flex;  
      align-items: center;  
      justify-content: center;  
      font-size: 14px;  
      font-weight: 500;  
      word-break: break-word;  
      height: 100%;  
      box-sizing: border-box;  
    }  

    .post-actions {  
      position: absolute;  
      bottom: 5px;  
      right: 5px;  
      display: flex;  
      gap: 5px;  
    }  

    .post-actions button {  
      background: rgba(0,0,0,0.6);  
      border: none;  
      color: white;  
      font-size: 12px;  
      border-radius: 5px;  
      padding: 2px 5px;  
      cursor: pointer;  
      width: auto;  
    }  

    /* --- Zoom Modal --- */  
    .modal {  
      display: none;  
      position: fixed;  
      top: 0; left: 0;  
      width: 100%; height: 100%;  
      background: rgba(0,0,0,0.8);  
      justify-content: center;  
      align-items: center;  
      z-index: 100;  
    }  

    .modal-content {  
      max-width: 90%;  
      max-height: 85%;  
      background: white;  
      border-radius: 12px;  
      padding: 20px;  
      position: relative;  
    }  

    .modal img,  
    .modal video {  
      max-width: 100%;  
      max-height: 100%;  
      border-radius: 12px;  
    }
    
    .close-modal {
      position: absolute;
      top: 10px;
      right: 15px;
      color: white;
      font-size: 30px;
      font-weight: bold;
      cursor: pointer;
      z-index: 101;
    }
    
    .text-post-modal {
      max-width: 400px;
      max-height: 400px;
      overflow-y: auto;
      padding: 20px;
      font-size: 18px;
      text-align: center;
    }

  </style>  
</head>  
<body>    
  <nav>  
    <a href="home2.html">🏠 Home</a>  
    <a href="match.html">💞 Match</a>  
    <a href="chats.html">💬 Chats</a>  
    <a href="profile.html">👤 Profile</a>  
  </nav>    
    
  <div class="container">  
    <h2>My Profile</h2>  
    <img id="profilePic" class="photo" src="https://via.placeholder.com/120" alt="Profile photo">  
    
    <!-- View Mode -->  
    <div id="viewMode">  
      <div class="profile-info">  
        <p><strong>Name:</strong> <span id="viewName">Loading...</span></p>  
        <p><strong>Age:</strong> <span id="viewAge">-</span></p>  
        <p><strong>Location:</strong> <span id="viewLocation">—</span></p>  
        <p><strong>Occupation:</strong> <span id="viewOccupation">—</span></p>  
        <p><strong>Marital Status:</strong> <span id="viewMarital">—</span></p>  
        <p><strong>Number of Kids:</strong> <span id="viewKids">—</span></p>  
        <p><strong>Hobbies:</strong> <span id="viewHobbies">—</span></p>  
        <p><strong>Favourite Meal:</strong> <span id="viewMeal">—</span></p>  
        <p><strong>Favourite Games:</strong> <span id="viewGames">—</span></p>  
        <p><strong>Bio:</strong></p>  
        <p id="viewBio" style="background:#f9f9f9;padding:10px;border-radius:8px;">—</p>  
      </div>  

      <div class="follow-stats">  
        <div onclick="toggleFollowers()">Followers: <span id="followerCount">0</span></div>  
        <div onclick="toggleFollowing()">Following: <span id="followingCount">0</span></div>  
      </div>  

      <div class="followers-list" id="followersList"></div>  
      <div class="followers-list" id="followingList"></div>  
    </div>  

    <!-- Edit Mode -->  
    <div id="editMode" style="display:none;">  
      <input id="photoInput" type="file" accept="image/*">  
      <input id="name" placeholder="Full name" />  
      <input id="age" type="number" placeholder="Age" min="18" />  
      <input id="location" placeholder="Your location" />  

      <select id="occupation">  
        <option value="">Select Occupation</option>  
        <option>Student</option>  
        <option>Engineer</option>  
        <option>Doctor</option>  
        <option>Teacher</option>  
        <option>Entrepreneur</option>  
        <option>Artist</option>  
        <option>Lawyer</option>  
        <option>Designer</option>  
        <option>Developer</option>  
        <option>Other</option>  
      </select>  

      <select id="marital">  
        <option value="">Select Marital Status</option>  
        <option>Single</option>  
        <option>In a Relationship</option>  
        <option>Married</option>  
        <option>Divorced</option>  
        <option>Widowed</option>  
      </select>  

      <input id="kids" type="number" placeholder="Number of kids" min="0" />  

      <label><strong>Hobbies</strong></label>  
      <div id="hobbiesContainer" class="chips-container"></div>  

      <input id="meal" placeholder="Favourite meal" />  
      <input id="games" placeholder="Favourite games" />  
      <textarea id="bio" placeholder="Write something about yourself..." rows="3"></textarea>  
      <button id="saveBtn">Save Profile</button>  
    </div>  

    <button id="toggleEdit">⚙️ Edit Profile</button>  
    <button id="logoutBtn">Logout</button>  

    <!-- My Posts -->  
    <div class="posts-section">  
      <h3 style="color:#ff4f87;">My Posts</h3>  
      <div id="userPosts" class="posts-grid"></div>  
    </div>
  </div>    

  <!-- Zoom Modal -->    
  <div class="modal" id="zoomModal">  
    <span class="close-modal" onclick="closeModal()">&times;</span>
    <div class="modal-content" id="modalContent"></div>  
  </div>    

  <!-- Firebase SDKs -->    
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>    
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-auth.js"></script>    
  <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-firestore.js"></script>    
    
  <script>  
    const firebaseConfig = {  
      apiKey: "AIzaSyD9dwHPDTJr1-mFXPW_JZnVS-JyZ6BNMgU",  
      authDomain: "smart-waste-66279.firebaseapp.com",  
      projectId: "smart-waste-66279",  
      storageBucket: "smart-waste-66279.appspot.com",  
      messagingSenderId: "619099585646",  
      appId: "1:619099585646:web:b193d2a9fc13347d88ba7f"  
    };  
    firebase.initializeApp(firebaseConfig);  
    const auth = firebase.auth();  
    const db = firebase.firestore();  
    
    let currentUserId = null;  
    let uploadedPhotoURL = '';  
    let isEditing = false;  
    
    const toggleEditBtn = document.getElementById('toggleEdit');  
    const viewMode = document.getElementById('viewMode');  
    const editMode = document.getElementById('editMode');  
    
    // Initialize hobbies
    const hobbies = [
      "Reading", "Traveling", "Cooking", "Gaming", "Sports", 
      "Music", "Dancing", "Photography", "Art", "Writing",
      "Yoga", "Movies", "Shopping", "Hiking", "Swimming"
    ];
    
    // Initialize hobbies chips
    const hobbiesContainer = document.getElementById('hobbiesContainer');
    hobbies.forEach(hobby => {
      const chip = document.createElement('div');
      chip.className = 'chip';
      chip.textContent = hobby;
      chip.onclick = () => chip.classList.toggle('selected');
      hobbiesContainer.appendChild(chip);
    });
    
    toggleEditBtn.addEventListener('click', () => {  
      isEditing = !isEditing;  
      viewMode.style.display = isEditing ? 'none' : 'block';  
      editMode.style.display = isEditing ? 'block' : 'none';  
      toggleEditBtn.textContent = isEditing ? '🔙 View Profile' : '⚙️ Edit Profile';  
      
      if (isEditing) {
        loadEditForm();
      }
    });  
    
    auth.onAuthStateChanged(async (user) => {  
      if (!user) return location.href = 'log1.html';  
      currentUserId = user.uid;  
      loadProfile();  
    });  
    
    async function loadProfile() {  
      const doc = await db.collection('users').doc(currentUserId).get();  
      if (doc.exists) {  
        const data = doc.data();  
        document.getElementById('viewName').textContent = data.fullName || 'No name';  
        document.getElementById('viewAge').textContent = data.age || '-';  
        document.getElementById('viewLocation').textContent = data.location || '—';  
        document.getElementById('viewOccupation').textContent = data.occupation || '—';  
        document.getElementById('viewMarital').textContent = data.maritalStatus || '—';  
        document.getElementById('viewKids').textContent = data.kids || '—';  
        document.getElementById('viewMeal').textContent = data.meal || '—';  
        document.getElementById('viewGames').textContent = data.games || '—';  
        document.getElementById('viewBio').textContent = data.bio || 'No bio yet';  
        document.getElementById('viewHobbies').textContent = Array.isArray(data.hobbies) ? data.hobbies.join(', ') : '—';  
        if (data.photoURL) document.getElementById('profilePic').src = data.photoURL;  
        
        // Load followers and following counts
        document.getElementById('followerCount').textContent = data.followers ? data.followers.length : 0;
        document.getElementById('followingCount').textContent = data.following ? data.following.length : 0;
      }  
      await loadUserPosts();  
    }  
    
    function loadEditForm() {
      db.collection('users').doc(currentUserId).get().then(doc => {
        if (doc.exists) {
          const data = doc.data();
          document.getElementById('name').value = data.fullName || '';
          document.getElementById('age').value = data.age || '';
          document.getElementById('location').value = data.location || '';
          document.getElementById('occupation').value = data.occupation || '';
          document.getElementById('marital').value = data.maritalStatus || '';
          document.getElementById('kids').value = data.kids || '';
          document.getElementById('meal').value = data.meal || '';
          document.getElementById('games').value = data.games || '';
          document.getElementById('bio').value = data.bio || '';
          
          // Reset hobbies selection
          document.querySelectorAll('.chip').forEach(chip => {
            chip.classList.remove('selected');
          });
          
          // Select saved hobbies
          if (Array.isArray(data.hobbies)) {
            data.hobbies.forEach(hobby => {
              document.querySelectorAll('.chip').forEach(chip => {
                if (chip.textContent === hobby) {
                  chip.classList.add('selected');
                }
              });
            });
          }
        }
      });
    }
    
    // Save profile function
    document.getElementById('saveBtn').addEventListener('click', async () => {
      const selectedHobbies = Array.from(document.querySelectorAll('.chip.selected'))
        .map(chip => chip.textContent);
      
      const userData = {
        fullName: document.getElementById('name').value,
        age: document.getElementById('age').value,
        location: document.getElementById('location').value,
        occupation: document.getElementById('occupation').value,
        maritalStatus: document.getElementById('marital').value,
        kids: document.getElementById('kids').value,
        hobbies: selectedHobbies,
        meal: document.getElementById('meal').value,
        games: document.getElementById('games').value,
        bio: document.getElementById('bio').value
      };
      
      try {
        await db.collection('users').doc(currentUserId).update(userData);
        alert('Profile updated successfully!');
        isEditing = false;
        viewMode.style.display = 'block';
        editMode.style.display = 'none';
        toggleEditBtn.textContent = '⚙️ Edit Profile';
        loadProfile();
      } catch (error) {
        console.error('Error updating profile:', error);
        alert('Error updating profile: ' + error.message);
      }
    });
    
    // Upload profile picture
    document.getElementById('photoInput').addEventListener('change', async (e) => {
  const file = e.target.files[0];
  if (!file) return;

  try {
    const key = "e26f20d023a0094ee31c68ded33ab41d";
    const form = new FormData();
    form.append('image', file);

    const res = await fetch(`https://api.imgbb.com/1/upload?key=${key}`, {
      method: 'POST',
      body: form
    });

    const json = await res.json();

    if (json.data && json.data.url) {
      // Update Firestore
      await db.collection('users').doc(currentUserId).update({
        photoURL: json.data.url
      });

      // Update profile image with cache-busting
      document.getElementById('profilePic').src = json.data.url + '?t=' + new Date().getTime();
      alert('Profile picture updated!');

      // Clear input so same file can be re-uploaded
      e.target.value = '';
    }
  } catch (error) {
    console.error('Error uploading photo:', error);
    alert('Error uploading photo: ' + error.message);
  }
});
    
    // Logout function
    document.getElementById('logoutBtn').addEventListener('click', () => {
      auth.signOut().then(() => {
        window.location.href = 'log1.html';
      });
    });
    
    async function loadUserPosts() {  
      const postsContainer = document.getElementById('userPosts');  
      postsContainer.innerHTML = '<p>Loading posts...</p>';  
      const snap = await db.collection('users').doc(currentUserId).collection('posts').orderBy('createdAt','desc').get();  
      if (snap.empty) {  
        postsContainer.innerHTML = '<p>No posts yet.</p>';  
        return;  
      }  
      postsContainer.innerHTML = '';  
      snap.forEach(doc => {  
        const p = doc.data();  
        const id = doc.id;  
        const card = document.createElement('div');  
        card.className = 'post-card';  
        
        let content = '';
        if (p.mediaType === 'video') {  
          content = `<video src="${p.mediaUrl}" onclick="zoomMedia('${p.mediaUrl}','video')" muted></video>`;  
        } else if (p.mediaType === 'image') {  
          content = `<img src="${p.mediaUrl}" onclick="zoomMedia('${p.mediaUrl}','image')">`;  
        } else if (p.text && p.bgColor) {
          // Text post with background color
          content = `<div class="text-post" style="background-color: ${p.bgColor};" onclick="zoomText('${p.text}', '${p.bgColor}')">${p.text}</div>`;
        } else if (p.text) {
          // Regular text post
          content = `<div class="text-post" onclick="zoomText('${p.text}', '#ffffff')">${p.text}</div>`;
        }
        
        card.innerHTML = `  
          ${content}  
          <div class="post-actions">  
            <button onclick="editPost('${id}')">✏️</button>  
            <button onclick="deletePost('${id}')">🗑️</button>  
          </div>  
        `;  
        postsContainer.appendChild(card);  
      });  
    }  
    
    async function deletePost(postId) {  
      if (!confirm('Delete this post permanently?')) return;  
      await db.collection('users').doc(currentUserId).collection('posts').doc(postId).delete();  
      // Also delete from main posts collection
      await db.collection('posts').doc(postId).delete();
      alert('Post deleted.');  
      loadUserPosts();  
    }  
    
    async function editPost(postId) {  
      const newText = prompt('Edit caption:');  
      if (newText === null) return;  
      await db.collection('users').doc(currentUserId).collection('posts').doc(postId).update({ text: newText });  
      // Also update in main posts collection
      await db.collection('posts').doc(postId).update({ text: newText });
      alert('Post updated.');  
      loadUserPosts();  
    }  
    
    function zoomMedia(url, type) {  
      const modal = document.getElementById('zoomModal');  
      const modalContent = document.getElementById('modalContent');  
      modalContent.innerHTML = type === 'video'  
        ? `<video src="${url}" controls autoplay></video>`  
        : `<img src="${url}" alt="">`;  
      modal.style.display = 'flex';  
    }  
    
    function zoomText(text, bgColor) {
      const modal = document.getElementById('zoomModal');  
      const modalContent = document.getElementById('modalContent');  
      modalContent.innerHTML = `<div class="text-post-modal" style="background-color: ${bgColor};">${text}</div>`;  
      modal.style.display = 'flex';  
    }
    
    function closeModal() {  
      document.getElementById('zoomModal').style.display = 'none';  
    }
    
    // Followers/Following functions
    async function toggleFollowers() {
      const followersList = document.getElementById('followersList');
      const followingList = document.getElementById('followingList');
      
      if (followersList.style.display === 'block') {
        followersList.style.display = 'none';
        return;
      }
      
      // Hide following list if open
      followingList.style.display = 'none';
      
      // Load followers
      followersList.innerHTML = '<p>Loading followers...</p>';
      followersList.style.display = 'block';
      
      const userDoc = await db.collection('users').doc(currentUserId).get();
      const userData = userDoc.data();
      const followers = userData.followers || [];
      
      if (followers.length === 0) {
        followersList.innerHTML = '<p>No followers yet.</p>';
        return;
      }
      
      followersList.innerHTML = '';
      for (const followerId of followers) {
        const followerDoc = await db.collection('users').doc(followerId).get();
        if (followerDoc.exists) {
          const followerData = followerDoc.data();
          const followerItem = document.createElement('div');
          followerItem.className = 'follower-item';
          followerItem.innerHTML = `
            <div style="display: flex; align-items: center;">
              <img src="${followerData.photoURL || 'https://via.placeholder.com/40'}" onclick="viewUserProfile('${followerId}')">
              <span>${followerData.fullName || 'Unknown User'}</span>
            </div>
          `;
          followersList.appendChild(followerItem);
        }
      }
    }
    
    async function toggleFollowing() {
      const followingList = document.getElementById('followingList');
      const followersList = document.getElementById('followersList');
      
      if (followingList.style.display === 'block') {
        followingList.style.display = 'none';
        return;
      }
      
      // Hide followers list if open
      followersList.style.display = 'none';
      
      // Load following
      followingList.innerHTML = '<p>Loading following...</p>';
      followingList.style.display = 'block';
      
      const userDoc = await db.collection('users').doc(currentUserId).get();
      const userData = userDoc.data();
      const following = userData.following || [];
      
      if (following.length === 0) {
        followingList.innerHTML = '<p>Not following anyone yet.</p>';
        return;
      }
      
      followingList.innerHTML = '';
      for (const followingId of following) {
        const followingDoc = await db.collection('users').doc(followingId).get();
        if (followingDoc.exists) {
          const followingData = followingDoc.data();
          const followingItem = document.createElement('div');
          followingItem.className = 'follower-item';
          followingItem.innerHTML = `
            <div style="display: flex; align-items: center;">
              <img src="${followingData.photoURL || 'https://via.placeholder.com/40'}" onclick="viewUserProfile('${followingId}')">
              <span>${followingData.fullName || 'Unknown User'}</span>
            </div>
            <button class="follow-back" onclick="unfollowUser('${followingId}')">Unfollow</button>
          `;
          followingList.appendChild(followingItem);
        }
      }
    }
    
    function viewUserProfile(userId) {
      window.location.href = `user.html?uid=${userId}`;
    }
    
    async function unfollowUser(userId) {
      if (!confirm('Unfollow this user?')) return;
      
      try {
        // Remove from current user's following list
        const userDoc = await db.collection('users').doc(currentUserId).get();
        const userData = userDoc.data();
        const following = userData.following || [];
        const followingIndex = following.indexOf(userId);
        
        if (followingIndex > -1) {
          following.splice(followingIndex, 1);
          await db.collection('users').doc(currentUserId).update({ following });
        }
        
        // Remove current user from target user's followers list
        const targetDoc = await db.collection('users').doc(userId).get();
        const targetData = targetDoc.data();
        const followers = targetData.followers || [];
        const followerIndex = followers.indexOf(currentUserId);
        
        if (followerIndex > -1) {
          followers.splice(followerIndex, 1);
          await db.collection('users').doc(userId).update({ followers });
        }
        
        alert('Unfollowed successfully!');
        toggleFollowing(); // Refresh the following list
        loadProfile(); // Refresh counts
      } catch (error) {
        console.error('Error unfollowing user:', error);
        alert('Error unfollowing user: ' + error.message);
      }
    }
  </script>  
